  ok n
  ok c
== default
  HAVE_CF_ERROR '-Werror'
  MKC_COMPFLAGS [
      '-Wunreachable-code'
      '-Wno-unreachable-code'
      '-Iabc'
      '-Idef'
      '-Werror'
    ]
  cf_Iabc '-Iabc'
  cf_Idef '-Idef'
  cf_no_unreachable_code '-Wno-unreachable-code'
  cf_unreachable_code '-Wunreachable-code'
== default c
  C_CF_G '-g'
  MKC_COMPFLAGS [ '-g' ]
