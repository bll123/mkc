  ok n
  ok c
  ok d
  ok e
== default
  HAVE_CF_ERROR 1
  MKC_COMPFLAGS [
      '-Wunreachable-code'
      '-Wno-unreachable-code'
      '-Iabc'
      '-Idef'
      '-Werror'
    ]
  cf_Iabc 1
  cf_Idef 1
  cf_no_stuff 0
  cf_no_unreachable_code 1
  cf_something_bad 0
  cf_unreachable_code 1
== default c
  C_CF_G 1
  MKC_COMPFLAGS [ '-g' ]
