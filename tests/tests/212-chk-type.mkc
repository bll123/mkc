check_type something_t {
  on_success {
    print '  fail a';
  }
  on_failure {
    print '  ok a';
  }
}
check_type int {
  on_success {
    print '  ok b';
  }
  on_failure {
    print '  fail b';
  }
}
check_type 'struct stat' {
  header sys/stat.h;
  name _have_stat;
}

if (${_type_something_t} == 0) {
  print '  ok';
} else {
  print '  fail something';
}
if (${_type_int} == 1) {
  print '  ok';
} else {
  print '  fail int';
}
if (${_have_stat} == 1 && ! is_defined (_type_struct_stat)) {
  print '  ok';
} else {
  print '  fail struct stat';
}
