# Copyright 2026 Brad Lanam Pleasant Hill CA

project mkctest {
  compiler c;
}

profile default {
  compiler c;
  add_compile_flag '-DMKCTEST=1';
}

mkcdebug printvar test;

check_include_compile {
  compiler_flags  '-Itests/data/258-stmt-chk-inc-compile';
  path  'tests/data/258-stmt-chk-inc-compile';
  match '\.h$';
}
