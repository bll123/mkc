	topochk.o \
	toposort.o \
	list.o \
	strutil.o \
	mkc_error.o

# executables

$(MKC_LOCAL): $(MKCOBJECTS)
	$(QUIET)$(CC) $(LDFLAGS) -o $(MKC_LOCAL) \
	    $(MKCOBJECTS) $(LIBS)
	@:

topochk: $(TOPOCHKOBJ)
	$(QUIET)$(CC) $(LDFLAGS) -o $@ $(TOPOCHKOBJ)

.c.o:
	$(QUIET)$(CC) -c $(CFLAGS) $<

